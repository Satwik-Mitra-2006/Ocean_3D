# Ocean3D Visualization Platform — Environment Configuration
APP_NAME="Ocean3D Visualization Platform Backend"
APP_ENV=development
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# CORS Origins (Allowed frontend clients)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# Copernicus Marine Service Configuration (Phase 2 Integration)
# Credentials and dataset targets for real-time and historical NetCDF extraction
# Register / obtain free credentials at: https://marine.copernicus.eu/
# ==============================================================================
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Default dataset: Global Ocean Physics Reanalysis
COPERNICUS_DATASET_ID=cmems_mod_glo_phy_my_0.083deg_P1D-m
